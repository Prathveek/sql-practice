
select Team_name, count(*) as no_of_matches, sum(win_flag) as win_matches, count(*)- sum(win_flag) as no_of_losses
from(select Team_1 as Team_name,case when Team_1 = Winner then 1 else 0 end as win_fag from icc_world_cup
UNION ALL
select Team_2 as Team_name, case when Team_2 = Winner then 1 else 0 end as win_flag
from icc_world_cup) as A
group by Team_name
order by no_of_wins desc;
